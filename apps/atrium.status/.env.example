# ─── Storage ────────────────────────────────────────────────────────────────
# Without these the app falls back to an in-memory store: it runs, but uptime
# and incidents reset on every cold start. Required for the deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Scheduled sweep ────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on cron invocations.
# With it unset the endpoint is open in development and closed in production.
# The GitHub Actions heartbeat sends the same value.
CRON_SECRET=""

# How old the stored data may be before a page view (or a GET /api/health)
# refreshes it in the background. Defaults to 10.
SWEEP_STALE_AFTER_MINUTES=""

# ─── What to monitor ────────────────────────────────────────────────────────
# Each of these turns a monitor on. Leave one blank and its monitor stays
# paused, with the reason shown on the dashboard instead of a false green.
NEXT_PUBLIC_WEBSITE_URL="https://atrium-platform-website.vercel.app/"
NEXT_PUBLIC_GRADER_URL="https://atrium-grader.vercel.app/"
NEXT_PUBLIC_STATUS_URL=""
NEXT_PUBLIC_CLIENT_CHWF_URL=""

# Used to build the Cloudinary probe URL. Same value as the website's.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="zqisihyg"

# ─── Alerting ───────────────────────────────────────────────────────────────
# Without this the app is a dashboard: it detects an outage and waits for
# somebody to open the page. The dashboard says so when it is unset.
#
# Alerts fire only on transitions — a system going down, and coming back. A
# system that has been down for a day is not re-sent.
#
# A Slack incoming webhook URL: https://hooks.slack.com/services/T…/B…/…
SLACK_WEBHOOK_URL=""

# Prove the wiring without waiting for a real outage. Guarded by CRON_SECRET,
# because it sends a real message to a real channel:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" $STATUS_URL/api/alerts/test
# GET the same URL to check whether it is configured without sending.

# ─── False-positive filtering ───────────────────────────────────────────────
# A single failed request is not an outage. A failing check is retried before the
# sweep records a verdict, so one dropped packet no longer opens an incident or
# dents the 30-day uptime number.
#
# Total attempts per check, so 2 means one retry. Defaults to 2.
MONITOR_ATTEMPTS=""
# Pause between attempts, ms. Defaults to 1200.
MONITOR_RETRY_BACKOFF_MS=""
# Consecutive failing sweeps needed to open an incident, on top of the retries.
# Defaults to 1, which the retry makes safe. Raise it if a flapping dependency
# starts paging people — at 2, detection costs one extra sweep interval.
MONITOR_SWEEPS_BEFORE_INCIDENT=""
