# ─── Storage ────────────────────────────────────────────────────────────────
# Without these the app falls back to an in-memory store: it runs, but uptime
# and incidents reset on every cold start. Required for the deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Scheduled sweep ────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on cron invocations.
# With it unset the endpoint is open in development and closed in production.
CRON_SECRET=""

# ─── What to monitor ────────────────────────────────────────────────────────
# Each of these turns a monitor on. Leave one blank and its monitor stays
# paused, with the reason shown on the dashboard instead of a false green.
NEXT_PUBLIC_WEBSITE_URL="https://atrium-platform-website.vercel.app/"
NEXT_PUBLIC_GRADER_URL="https://atrium-grader.vercel.app/"
NEXT_PUBLIC_STATUS_URL=""
NEXT_PUBLIC_CLIENT_CHWF_URL=""

# Used to build the Cloudinary probe URL. Same value as the website's.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="zqisihyg"
